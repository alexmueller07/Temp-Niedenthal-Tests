# ---- Corpus and derived media: NEVER commit ----
# The Chicago Face Database licence forbids redistributing images, and this repo
# is public. No dataset images, crops, frame sequences, or rendered faces.
corpus/
*.jpg
*.jpeg
*.png
*.mp4
*.mkv
*.webm
*.avi
corpus.local.json

# ...except the analysis figures, which are plots of aggregate numbers with no
# face in them. Anything containing a face goes in figures/faces/ and stays out.
!artifacts/figures/*.png
artifacts/figures/faces/

# Derived from CFD images, and keyed by individual model ID: aggregate statistics
# are fine to publish, per-person values are not.
artifacts/cache/
artifacts/runs/
artifacts/amplitudes.json
artifacts/rests.json
scratchpad/

# ---- Dependencies / build ----
node_modules/
public/dist/
public/models/
public/vendor/
__pycache__/
*.pyc
.venv/
venv/

# ---- OS ----
.DS_Store
Thumbs.db
